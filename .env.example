PORT=3000
DATA_DIR=./data
NODE_ENV=production

# Optional: host path for downloaded VOD movies/episodes when using
# docker-compose.yml (defaults to ./data/downloads if unset)
# DOWNLOADS_HOST_PATH=./data/downloads

# Optional: Pre-configure a portal at startup
# PORTAL_URL=http://your.portal.url/c/
# PORTAL_MAC=00:1A:79:XX:XX:XX
# PORTAL_TIMEZONE=America/New_York
